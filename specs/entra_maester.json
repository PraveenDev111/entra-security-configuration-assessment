    {
      "id": "ENTRA.MT.1019",
      "reference": "MT.1019",
      "framework": "Jolera Extended Controls",
      "area": "Entra ID",
      "title": "A Conditional Access policy enforces application restrictions for unmanaged devices",
      "severity": "Medium",
      "licence": "Entra ID P1",
      "nist": "PR.AA-05",
      "source": "CA_Policies",
      "mode": "any",
      "conditions": [
        {
          "path": "state",
          "op": "eq",
          "value": "enabled"
        },
        {
          "path": "conditions.users.includeUsers",
          "op": "contains",
          "value": "All"
        },
        {
          "path": "conditions.clientAppTypes",
          "op": "contains",
          "value": "All"
        },
        {
          "path": "sessionControls.applicationEnforcedRestrictions.isEnabled",
          "op": "true"
        },
        {
          "path": "conditions.applications.includeApplications",
          "op": "contains",
          "value": "Office365"
        }
      ],
      "name": "displayName",
      "fail_if_empty": false,
      "empty_message": "No Conditional Access policies found",
      "description": "Application enforced restrictions let SharePoint Online and Exchange Online limit what users can do from unmanaged devices (for example browser-only access without download). An enabled policy must apply to all users and client app types, target Office 365 and turn on application enforced restrictions.",
      "remediation": "In the Entra admin center > Entra ID > Conditional Access > Policies, create a policy for all users, target Office 365, and under Session select Use app enforced restrictions. Configure the matching limited-access policy in SharePoint and Exchange.",
      "impact": "Users on unmanaged devices get limited, browser-only access to SharePoint, OneDrive and Exchange.",
      "links": [
        {
          "text": "Use application enforced restrictions for unmanaged devices",
          "url": "https://learn.microsoft.com/entra/identity/conditional-access/policy-all-users-app-enforced-restrictions"
        }
      ],
      "origin": "Maester Test-MtCaApplicationEnforcedRestriction (MT.1019)"
    },
    {
      "id": "ENTRA.MT.1072",
      "reference": "MT.1072",
      "framework": "Jolera Extended Controls",
      "area": "Entra ID",
      "title": "No Conditional Access policy uses the deprecated Approved Client App grant",
      "severity": "High",
      "licence": "Entra ID P1",
      "nist": "PR.PS-01",
      "source": "CA_Policies",
      "mode": "none",
      "conditions": [
        {
          "path": "state",
          "op": "eq",
          "value": "enabled"
        },
        {
          "path": "grantControls.builtInControls",
          "op": "contains",
          "value": "approvedApplication"
        }
      ],
      "name": "displayName",
      "fail_if_empty": false,
      "description": "The Require approved client app grant control is retired and Microsoft no longer enforces it, which leaves a policy that relies on it without the intended protection. Move to Require app protection policy.",
      "remediation": "In the Entra admin center > Entra ID > Conditional Access > Policies, open each listed policy and replace Require approved client app with Require app protection policy (or add it alongside), then review the result in report-only mode.",
      "links": [
        {
          "text": "Migrate approved client app to application protection policy",
          "url": "https://learn.microsoft.com/entra/identity/conditional-access/migrate-approved-client-app"
        }
      ],
      "origin": "Maester Test-MtCaApprovedClientApp (MT.1072)"
    },
    {
      "id": "ENTRA.MT.1184",
      "reference": "MT.1184",
      "framework": "Jolera Extended Controls",
      "area": "Entra ID",
      "title": "No Conditional Access policy is missing a target resource",
      "severity": "Medium",
      "licence": "Entra ID P1",
      "nist": "PR.PS-01",
      "source": "CA_Policies",
      "mode": "all",
      "conditions": [
        {
          "any": [
            {
              "all": [
                {
                  "path": "conditions.applications.includeApplications",
                  "op": "notempty"
                },
                {
                  "path": "conditions.applications.includeApplications",
                  "op": "notcontains",
                  "value": "None"
                }
              ]
            },
            {
              "path": "conditions.applications.includeUserActions",
              "op": "notempty"
            },
            {
              "path": "conditions.applications.includeAuthenticationContextClassReferences",
              "op": "notempty"
            },
            {
              "path": "conditions.applications.applicationFilter",
              "op": "notempty"
            }
          ]
        }
      ],
      "name": "displayName",
      "fail_if_empty": false,
      "description": "A policy can be saved with no cloud apps, user actions or authentication context selected. It then applies to nothing but looks like active protection. All policies (any state) must target at least one of these.",
      "remediation": "Open each listed policy under Target resources and select cloud apps or resources, user actions or an authentication context, or delete the policy if it is no longer needed.",
      "links": [
        {
          "text": "Conditional Access: cloud apps, actions and authentication context",
          "url": "https://learn.microsoft.com/entra/identity/conditional-access/concept-conditional-access-cloud-apps"
        }
      ],
      "origin": "Maester Test-MtCaUntargetedPolicy (MT.1184)"
    },
    {
      "id": "ENTRA.MT.1197",
      "reference": "MT.1197",
      "framework": "Jolera Extended Controls",
      "area": "Entra ID",
      "title": "No dynamic group uses the retiring memberOf rule operator",
      "severity": "High",
      "licence": "Entra ID P1",
      "nist": "PR.AA-05",
      "source": "Groups",
      "mode": "none",
      "filter": [
        {
          "path": "groupTypes",
