      "name": "displayName",
      "fail_if_empty": false,
      "empty_message": "No Conditional Access policies found",
      "description": "Azure management (Azure portal, ARM, CLI) gives control over cloud resources. An enabled policy must require MFA or an MFA authentication strength for all users, or for the 14 privileged roles Maester lists, and cover Windows Azure Service Management, the Microsoft Admin Portals or all apps. Policies that only apply on elevated sign-in or user risk or a forced password change are ignored.",
      "remediation": "In the Entra admin center > Entra ID > Conditional Access > Policies, create a policy that includes all users (or the administrator roles), targets Windows Azure Service Management API and requires multifactor authentication or an MFA authentication strength.",
      "links": [
        {
          "text": "Require MFA for Azure management",
          "url": "https://learn.microsoft.com/entra/identity/conditional-access/policy-all-users-azure-management"
        }
      ],
      "origin": "Maester Test-MtCaMfaForAdminManagement (MT.1008)"
    },
