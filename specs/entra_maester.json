  "rules": [
    {
      "id": "ENTRA.MT.1003",
      "reference": "MT.1003",
      "framework": "Jolera Extended Controls",
      "area": "Entra ID",
      "title": "At least one Conditional Access policy targets all cloud apps",
      "severity": "High",
      "licence": "Entra ID P1",
      "nist": "PR.AA-05",
      "source": "CA_Policies",
      "mode": "any",
      "conditions": [
        {
          "path": "state",
          "op": "eq",
          "value": "enabled"
        },
        {
          "path": "grantControls.builtInControls",
          "op": "notcontains",
          "value": "passwordChange"
        },
        {
          "path": "conditions.applications.includeApplications",
          "op": "contains",
          "value": "All"
        }
      ],
      "name": "displayName",
      "fail_if_empty": false,
      "empty_message": "No Conditional Access policies found",
      "description": "Microsoft recommends at least one enabled Conditional Access policy that targets all cloud apps, so apps that have no policy of their own still get a baseline control. Policies that only force a password change are not counted.",
      "remediation": "In the Entra admin center > Entra ID > Conditional Access > Policies, create or edit a policy so that Target resources is set to all resources (cloud apps) and enable it.",
      "links": [
        {
          "text": "Plan a Conditional Access deployment",
          "url": "https://learn.microsoft.com/entra/identity/conditional-access/plan-conditional-access"
        }
      ],
      "origin": "Maester Test-MtCaAllAppsExists -SkipCheckAllUsers (MT.1003)"
    },
    {
      "id": "ENTRA.MT.1004",
      "reference": "MT.1004",
      "framework": "Jolera Extended Controls",
      "area": "Entra ID",
      "title": "At least one Conditional Access policy targets all cloud apps and all users",
      "severity": "High",
      "licence": "Entra ID P1",
      "nist": "PR.AA-05",
      "source": "CA_Policies",
      "mode": "any",
      "conditions": [
        {
          "path": "state",
          "op": "eq",
          "value": "enabled"
        },
        {
          "path": "grantControls.builtInControls",
          "op": "notcontains",
          "value": "passwordChange"
        },
        {
          "path": "conditions.users.includeUsers",
          "op": "contains",
          "value": "All"
        },
        {
          "path": "conditions.applications.includeApplications",
          "op": "contains",
          "value": "All"
        }
      ],
      "name": "displayName",
      "fail_if_empty": false,
      "empty_message": "No Conditional Access policies found",
      "description": "Microsoft recommends a fallback Conditional Access policy that applies to all cloud apps and all users, so no user or app is left outside Conditional Access. Policies that only force a password change are not counted.",
      "remediation": "In the Entra admin center > Entra ID > Conditional Access > Policies, create or edit a policy with Users set to All users and Target resources set to all resources, then enable it. Exclude only emergency access accounts.",
      "links": [
        {
          "text": "Plan a Conditional Access deployment",
          "url": "https://learn.microsoft.com/entra/identity/conditional-access/plan-conditional-access"
        }
      ],
      "origin": "Maester Test-MtCaAllAppsExists (MT.1004)"
    },
    {
