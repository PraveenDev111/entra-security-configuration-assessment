    },
    {
      "id": "ENTRA.MT.1182",
      "reference": "MT.1182",
      "framework": "Jolera Extended Controls",
      "area": "Entra ID",
      "title": "Verified managed domains publish a mature DMARC policy (p=reject, pct=100)",
      "severity": "Medium",
      "licence": "",
      "nist": "PR.DS-02",
      "source": "DNS_MailAuth",
      "mode": "all",
      "filter": [
        {
          "path": "authentication_type",
          "op": "eq",
          "value": "Managed"
        },
        {
          "path": "is_initial",
          "op": "false"
        },
        {
          "path": "domain",
          "op": "regex",
          "value": "^(?!.*onmicrosoft\\.com$)"
        }
      ],
      "conditions": [
        {
          "path": "dmarc_policy",
          "op": "eq",
          "value": "reject"
        },
        {
          "path": "dmarc_pct",
          "op": "ge",
          "value": 100
        }
      ],
      "name": "domain",
      "fail_if_empty": false,
      "description": "Without an enforced DMARC policy, spoofed mail using your domain can reach recipients. Every verified, managed (non-federated) domain except the initial onmicrosoft.com domain should publish p=reject with pct=100. Maester evaluates the registrable parent domain; here each verified domain is judged by its own DMARC data.",
      "remediation": "Publish a DMARC TXT record at _dmarc.<domain> such as v=DMARC1; p=reject; pct=100; rua=mailto:<reports address>. Start with p=none or quarantine and move to reject once reports are clean.",
      "links": [
        {
          "text": "Form the DMARC TXT record for your domain",
          "url": "https://learn.microsoft.com/microsoft-365/security/office-365-security/email-authentication-dmarc-configure"
        }
      ],
      "origin": "Maester Test-MtDomainsDmarcRecordMaturity (MT.1182)"
    },
